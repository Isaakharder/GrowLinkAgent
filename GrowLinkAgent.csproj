<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GrowLinkAgent</AssemblyName>
    <RootNamespace>GrowLinkAgent</RootNamespace>
    <Product>GrowLinkAgent</Product>
    <Description>GrowLink PDF upload agent</Description>
    <!-- Sent with every climate upload (agent_version); keep in step with GrowLinkAgent.iss. -->
    <Version>1.1.0</Version>
    <Company>GrowLink</Company>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <Platforms>AnyCPU</Platforms>
    <!-- Self-contained single-file publish — no .NET runtime required on the target machine -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- DPAPI-based secure local storage for upload key (current-user scope) -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- GrowLinkAgent.Tests lives under this project's own directory; without this,
         the default SDK glob would compile its files into this project too. -->
    <Compile Remove="GrowLinkAgent.Tests\**" />
    <Compile Remove="GrowLinkAgent.CoreTests\**" />
  </ItemGroup>

</Project>
